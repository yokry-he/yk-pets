{
  "schemaVersion": 1,
  "cases": [
    {
      "id": "classic-default-front",
      "route": "/studio-visual-audit?body=ellipsoid&head=classic-round&eyes=round&belly=ellipse&view=front",
      "automatedChecks": [
        "belly-front-facing-winding",
        "belly-surface-offset",
        "eye-surface-exposure"
      ],
      "manualChecks": [
        "belly-visible",
        "front-paws-at-classic-anchor",
        "hind-paws-balanced",
        "mouth-not-floating"
      ]
    },
    {
      "id": "classic-default-left",
      "route": "/studio-visual-audit?body=ellipsoid&head=classic-round&eyes=round&belly=ellipse&view=left",
      "automatedChecks": [
        "belly-curves-with-body",
        "muzzle-anchor-follows-head-surface"
      ],
      "manualChecks": [
        "belly-not-flat-or-floating",
        "nose-and-mouth-not-detached",
        "paws-occlude-belly-naturally"
      ]
    },
    {
      "id": "spark-eye-left",
      "route": "/studio-visual-audit?body=ellipsoid&head=classic-round&eyes=spark&belly=ellipse&view=left",
      "automatedChecks": [
        "spark-minimum-projected-size",
        "spark-blink-floor",
        "eye-outside-head-surface"
      ],
      "manualChecks": [
        "spark-shape-readable",
        "outline-visible",
        "eye-not-buried-in-head"
      ]
    },
    {
      "id": "rounded-cube-belly-front",
      "route": "/studio-visual-audit?body=rounded-cube&head=rounded-cube&eyes=diamond&belly=rounded-rectangle&view=front",
      "automatedChecks": [
        "belly-coplanar-with-flat-front",
        "triangle-normal-direction"
      ],
      "manualChecks": [
        "belly-visible-on-flat-front",
        "diamond-eyes-readable",
        "no-z-fighting"
      ]
    },
    {
      "id": "asymmetric-paws-manual",
      "route": "/studio/appearance",
      "recipeOverrides": {
        "frontPawDesign.mirror": false,
        "frontPawDesign.leftOffsetY": 0.2,
        "frontPawDesign.rightOffsetY": -0.16,
        "hindPawDesign.mirror": false,
        "hindPawDesign.leftOffsetX": -0.18,
        "hindPawDesign.rightOffsetX": 0.16
      },
      "automatedChecks": [
        "front-and-hind-paw-values-survive-normalization"
      ],
      "manualChecks": [
        "left-and-right-paws-are-visibly-independent",
        "no-unintended-mirroring",
        "no-paw-detachment"
      ]
    },
    {
      "id": "custom-motion-timeline-preview",
      "route": "/studio/motion",
      "setup": {
        "createMotion": true,
        "keyframes": [
          "root.position.y@0=0",
          "root.position.y@600=1",
          "mouth.open@300=1"
        ]
      },
      "automatedChecks": [
        "single-canonical-tres-canvas",
        "semantic-pose-propagation",
        "timeline-keyframe-selection",
        "un-authored-channel-preservation"
      ],
      "manualChecks": [
        "playhead-drives-preview",
        "mouth-keyframe-does-not-disable-un-authored-blink",
        "body-and-belly-move-together",
        "refresh-restores-saved-motion"
      ]
    },
    {
      "id": "motion-prop-hold-throw-catch",
      "route": "/studio/motion",
      "setup": {
        "propKind": "composite",
        "events": [
          "create@0",
          "attach:right-front-paw@0",
          "detach:world@500",
          "move@800",
          "attach:left-front-paw@1200",
          "destroy@1800"
        ]
      },
      "automatedChecks": [
        "prop-event-time-resolution",
        "single-tres-canvas-prop-instance",
        "missing-dependency-diagnostic"
      ],
      "manualChecks": [
        "prop-attaches-to-right-paw",
        "detached-prop-moves-in-world-space",
        "prop-catches-on-left-paw",
        "destroy-removes-instance"
      ]
    },
    {
      "id": "prop-entity-material-anchor",
      "route": "/studio/props",
      "automatedChecks": [
        "prop-component-budget",
        "prop-hierarchy-cycle-cleanup",
        "prop-material-range-normalization",
        "prop-anchor-transform-persistence",
        "sole-scene-prop-model"
      ],
      "manualChecks": [
        "component-tree-edits-visible",
        "materials-readable-on-dark-and-light",
        "grip-display-emitter-anchors-align",
        "no-depth-order-regression"
      ]
    },
    {
      "id": "advanced-motion-guides-glb",
      "route": "/studio/motion",
      "automatedChecks": [
        "smooth-bezier-curve-evaluation",
        "motion-layer-weight-composition",
        "semantic-onion-guide-single-scene",
        "motion-path-sample-budget",
        "local-glb-header-uri-validation"
      ],
      "manualChecks": [
        "curve-controls-usable",
        "onion-guides-readable-not-pet-clones",
        "motion-path-does-not-obscure-pet",
        "local-audio-user-gesture-works",
        "safe-glb-renders-without-network"
      ]
    },
    {
      "id": "motion-direct-body-part-authoring",
      "route": "/studio/motion",
      "setup": {
        "createMotion": true,
        "selectedPart": "root",
        "scope": "current-frame",
        "mode": "scale"
      },
      "automatedChecks": [
        "body-part-control-registry",
        "three-authoring-scopes",
        "uniform-scale-three-channel-write",
        "whole-clip-additive-correction-layer",
        "symmetry-channel-pairing"
      ],
      "manualChecks": [
        "direct-pad-drag-is-responsive",
        "part-tree-and-preview-selection-stay-synchronized",
        "whole-pet-scale-reads-as-multiplier",
        "selected-keyframe-scope-only-edits-selection",
        "undo-restores-one-complete-drag-gesture"
      ]
    }
  ]
}
